# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Staged from node_modules by scripts/copy-maplibre-worker.mjs on dev/build.
/public/maplibre/

# Page OCR kept for offline re-cropping of newspaper passages; not served.
# Regenerate with: npm run fetch-frontpages <theater> --force
# Page OCR is kept IN the repo deliberately. It is 2.3 MB, nothing at runtime
# reads it, and it is technically regenerable — but regenerating means hours of
# requests against an archive that rate-limits to a hard stop. Cheaper to carry.
